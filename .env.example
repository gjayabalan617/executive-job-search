# Copy to .env and edit. Never commit .env. Every value below is optional unless noted.

# --- Source mode (choose explicitly; employer_direct is NOT LinkedIn-origin) ---
EJS_MODE=employer_direct            # linkedin_only | employer_direct

# --- Storage (mount a volume here in Docker) ---
EJS_DATA_DIR=./data
EJS_SEEN_PATH=./data/seen_jobs.json  # spec default: /home/user/workspace/job_search/seen_jobs.json
EJS_BOARDS_FILE=./boards.yaml        # employer board registry (see boards.example.yaml)

# --- Screening ---
EJS_FRESHNESS_DAYS=14
EJS_MIN_SCORE=80
EJS_MIN_DESCRIPTION_CHARS=500

# --- linkedin_only: ONLY an authorised, licensed feed file is supported (no scraping) ---
EJS_LINKEDIN_PROVIDER=               # authorized_feed
EJS_LINKEDIN_FEED_PATH=

# --- Optional LLM evaluator (OFF by default; paid API usage needs your approval) ---
EJS_LLM_ENABLED=false
ANTHROPIC_API_KEY=
EJS_ANTHROPIC_MODEL=                 # required when enabled; no default is assumed
EJS_LLM_MAX_CALLS_PER_RUN=25
EJS_LLM_MAX_TOKENS_PER_RUN=200000
EJS_LLM_USD_CAP_PER_RUN=             # optional; needs both price vars below
EJS_LLM_PRICE_IN_PER_MTOK=
EJS_LLM_PRICE_OUT_PER_MTOK=

# --- Email notifications (OFF until you set this to true AND fill SMTP) ---
EJS_NOTIFY_SEND_ENABLED=false
EJS_NOTIFY_UNKNOWN_DATE=false
EJS_SMTP_HOST=
EJS_SMTP_PORT=587
EJS_SMTP_USER=
EJS_SMTP_PASSWORD=
EJS_SMTP_STARTTLS=true
EJS_SMTP_FROM=
EJS_SMTP_TO=

EJS_LOG_LEVEL=INFO
